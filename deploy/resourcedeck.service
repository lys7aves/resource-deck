[Unit]
Description=ResourceDeck monitoring dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=RESOURCEDECK_CONFIG=@CONFIG_PATH@
ExecStart=@EXECUTABLE@
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
